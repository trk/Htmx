<?php

declare(strict_types=1);

namespace {{namespace}};

use Totoglu\Htmx\Component;

class {{className}} extends Component
{
	/**
	 * Public properties form the signed state contract (dehydrated into `hx__state` and rehydrated via compiled Reflection schema).
	 * ProcessWire `Page` and `PageArray` properties are automatically collapsed to IDs and restored.
	 */
	public int $count = 0;

	/**
	 * Optional: set `protected bool $cacheRender = true;` (or call `$this->enableRenderCache(true, 3600)`)
	 * to enable tokenized component render caching for identical state payloads.
	 */
	protected bool $cacheRender = false;

	public function mount(): void
	{
		// One-time initialization logic (runs once on first render, not on rehydration)
	}

	/**
	 * Example POST mutation action — triggered when a form submits `__htmx_action=yourAction`
	 * or a button with `actionTrigger('yourAction')` is clicked (CSRF-verified).
	 */
	public function yourAction(): void
	{
		$this->count++;

		// Available helpers for HTMX v4 responses:
		// $this->htmx->response->trigger('someEvent', ['count' => $this->count]);
		// $this->htmx->response->triggerAfterSwap('someEventAfterSwap', ['count' => $this->count]);
		// $this->htmx->response->retarget('#other-target');
		// $this->htmx->response->reselect('#only-this');
		// $this->htmx->response->noSwap();
		// $this->htmx->fragment->addPartial('#toast', "<div id='toast'>Saved</div>", 'outerMorph');
		// $this->validationError('#form-wrapper', '#form-wrapper', 422);
	}

	/**
	 * Example GET/QUERY read-only action — methods prefixed with `query*` can be invoked via GET without CSRF.
	 */
	public function queryPreview(): string
	{
		return "<span>Count: {$this->count}</span>";
	}

	public function render(): string
	{
		$url = $this->requestUrl();
		$id  = 'hxc_' . $this->id();

		// HTMX v4 preferred form syntax: hx-action + hx-method + outerMorph swap
		// Use Ui::make()->actionTrigger('yourAction') for submit buttons that carry action names.

		return "
		<div id='{$id}'>
			<form hx-action='{$url}' hx-method='post' hx-target='#{$id}' hx-swap='outerMorph'>
				{$this->renderStatePayload()}

				<div>
					<!-- Your component markup here -->
					<h3>{{className}} Component</h3>
					<p class='uk-text-meta'>HTMX v4 ready: hx-action/hx-method, outerMorph, signed state payload.</p>
				</div>

				<div class='uk-margin-top'>
					<button type='submit' name='__htmx_action' value='yourAction' class='uk-button uk-button-primary'>
						Trigger yourAction
					</button>
				</div>
			</form>
		</div>";
	}
}
