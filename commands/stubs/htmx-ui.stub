<?php

declare(strict_types=1);

namespace {{namespace}};

use Totoglu\Htmx\Ui;

class {{className}} extends Ui
{
	public string $name = '{{slug}}';

	/**
	 * Structural parameters included in the compiled HtmxCache Shape hash.
	 *
	 * @var array<string, mixed>
	 */
	public array $shapeParams = [
		'tag' => 'div',
		'variant' => 'default',
	];

	/**
	 * Dynamic slot content parameters injected at runtime into `$s[...]` (excluded from Shape hash).
	 *
	 * @var array<string, mixed>
	 */
	public array $slotParams = [
		'title' => '',
		'body' => '',
	];

	/**
	 * Component-defined layout zones (flat list or grouped map).
	 *
	 * @var array<int|string, string|array<int, string>>
	 */
	protected array $zones = [
		'left',
		'center',
		'right',
	];

	/**
	 * Default item-to-zone placements.
	 *
	 * @var array<string, string>
	 */
	protected array $defaultZones = [
		'title' => 'center',
		'body' => 'center',
	];

	/**
	 * Value Gate keys: if non-empty, at least one key (or `$this->children`) must have a value
	 * for the element to render; otherwise `renderIfHasValue()` returns `''` without touching cache.
	 *
	 * @var array<int, string>
	 */
	protected array $valueGateKeys = ['title', 'body'];

	/**
	 * Phase 1 (Cache Miss Only): Resolve structural classes and tags before compiling the template.
	 *
	 * @return array<string, mixed>
	 */
	protected function resolveShape(): array
	{
		$variant = (string) $this->parameters->get('variant', 'default');
		$this->prependClass(['ui-{{slug}}', "ui-{{slug}}-{$variant}"]);

		$shape = parent::resolveShape();
		$shape['tag'] = (string) $this->parameters->get('tag', 'div');
		return $shape;
	}

	/**
	 * Phase 1 (Cache Miss Only): Return the compiled PHP closure source for `HtmxCache`.
	 *
	 * @param array<string, mixed> $shape
	 */
	protected function compileTemplate(array $shape): string
	{
		$tag = (string) ($shape['tag'] ?? 'div');
		$open = self::compileOpenTag($tag, (string) ($shape['classAttr'] ?? ''));
		$close = var_export("</{$tag}>", true);
		$zoneMap = $shape['zoneMap'] ?? [];

		$leftExpr = self::compileZoneItemsExpr($zoneMap['left'] ?? []);
		$centerExpr = self::compileZoneItemsExpr($zoneMap['center'] ?? []);
		$rightExpr = self::compileZoneItemsExpr($zoneMap['right'] ?? []);

		return "static function (array \$s, array \$attrs, string \$children): string {\n"
			. "\t\$html = {$open};\n"
			. "\t\$left = {$leftExpr};\n"
			. "\t\$center = {$centerExpr} . \$children;\n"
			. "\t\$right = {$rightExpr};\n"
			. "\tif (\$left !== '') { \$html .= '<div class=\"ui-{{slug}}-left\">' . \$left . '</div>'; }\n"
			. "\tif (\$center !== '') { \$html .= '<div class=\"ui-{{slug}}-center\">' . \$center . '</div>'; }\n"
			. "\tif (\$right !== '') { \$html .= '<div class=\"ui-{{slug}}-right\">' . \$right . '</div>'; }\n"
			. "\treturn \$html . {$close};\n"
			. "}";
	}
}
